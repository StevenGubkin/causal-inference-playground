{
  "name": "causal-inference-playground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w packages/app",
    "build": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "npm run validate -w packages/validation",
    "lint": "eslint .",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "eslint": "^9.12.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.11.0",
    "vitest": "^4.1.10"
  }
}
